# ==============================================================================
# Model Configuration for AI Agents
# ==============================================================================

# Option 1: Local Ollama (Default - Free, Offline, Private)
MODEL_ID=ollama_chat/qwen2.5-coder:7b
MODEL_API_BASE=http://127.0.0.1:11434
MODEL_NUM_CTX=8192

# Option 2: Google Gemini (Requires GEMINI_API_KEY)
# MODEL_ID=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Groq (Ultra-fast inference, has free tier, requires GROQ_API_KEY)
# MODEL_ID=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Option 4: OpenAI (Requires OPENAI_API_KEY)
# MODEL_ID=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here

# Option 5: Anthropic Claude (Requires ANTHROPIC_API_KEY)
# MODEL_ID=anthropic/claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# Fallback model (optional)
# ==============================================================================
# If the primary model fails (e.g. Ollama host offline), requests switch to this one.
# FALLBACK_MODEL_ID=groq/llama-3.3-70b-versatile
# FALLBACK_MODEL_API_BASE=
# FALLBACK_MODEL_API_KEY=        # or rely on the provider's own var, e.g. GROQ_API_KEY
# FALLBACK_MODEL_NUM_CTX=8192    # Ollama fallbacks only

# ==============================================================================
# Agent behaviour (optional)
# ==============================================================================
# AGENT_MAX_STEPS=6
# AGENT_VERBOSITY=2              # 0 = off, 1 = info, 2 = debug

# Custom prompt templates (optional; defaults to the prompts.yaml shipped in the package)
# PROMPTS_PATH=/path/to/my_prompts.yaml

# ==============================================================================
# Web Search (resilient DuckDuckGo / ddgs wrapper)
# ==============================================================================
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT=10
# Comma-separated backends tried in order until one returns results
# SEARCH_BACKENDS=duckduckgo,auto,wikipedia

# ==============================================================================
# Web UI (app.py)
# ==============================================================================
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=false             # true publishes a public *.gradio.live link
