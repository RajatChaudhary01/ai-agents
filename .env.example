# ==============================================================================
# Model Configuration for AI Agents
# ==============================================================================

# Option 1: Local Ollama (Default - Free, Offline, Private)
MODEL_ID=ollama_chat/qwen2.5-coder:7b
MODEL_API_BASE=http://127.0.0.1:11434
MODEL_NUM_CTX=8192

# Option 2: Google Gemini (Requires GEMINI_API_KEY)
# MODEL_ID=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Groq (Ultra-fast inference, has free tier, requires GROQ_API_KEY)
# MODEL_ID=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Option 4: OpenAI (Requires OPENAI_API_KEY)
# MODEL_ID=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here

# Option 5: Anthropic Claude (Requires ANTHROPIC_API_KEY)
# MODEL_ID=anthropic/claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# Fallback chain (optional)
# ==============================================================================
# If the primary model fails (Ollama offline, rate limit, provider error), requests move
# to FALLBACK_MODEL_*, then FALLBACK_MODEL_2_* ... FALLBACK_MODEL_9_*, in order.
# Gaps in the numbering are fine. Each slot accepts _ID, _API_BASE, _API_KEY, _NUM_CTX;
# without _API_KEY, LiteLLM reads the provider's own variable (GROQ_API_KEY, etc.).
#
# Providers with a free tier (model names change often - check each provider's list):
# FALLBACK_MODEL_ID=groq/llama-3.3-70b-versatile                          # GROQ_API_KEY
# FALLBACK_MODEL_2_ID=gemini/gemini-2.5-flash                             # GEMINI_API_KEY
# FALLBACK_MODEL_3_ID=cerebras/llama-3.3-70b                              # CEREBRAS_API_KEY
# FALLBACK_MODEL_4_ID=openrouter/meta-llama/llama-3.3-70b-instruct:free   # OPENROUTER_API_KEY
# FALLBACK_MODEL_5_ID=mistral/mistral-small-latest                        # MISTRAL_API_KEY
#
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# ==============================================================================
# Agent behaviour (optional)
# ==============================================================================
# AGENT_MAX_STEPS=6
# AGENT_VERBOSITY=2              # 0 = off, 1 = info, 2 = debug

# Custom prompt templates (optional; defaults to the prompts.yaml shipped in the package)
# PROMPTS_PATH=/path/to/my_prompts.yaml

# ==============================================================================
# Web Search (resilient DuckDuckGo / ddgs wrapper)
# ==============================================================================
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT=10
# Comma-separated backends tried in order until one returns results
# SEARCH_BACKENDS=duckduckgo,auto,wikipedia

# ==============================================================================
# Web UI (app.py / ai-agents-web)
# ==============================================================================
# Hosting mode for serving other people: run with --host, or set APP_MODE=host.
# APP_MODE=local                 # local | host
# APP_CONCURRENCY=1              # parallel requests (host default 4)
# APP_MAX_SESSIONS=5             # open conversations kept (host default 50)
# APP_SESSION_TTL_MINUTES=60     # idle conversations are dropped after this
# APP_MAX_MESSAGE_CHARS=20000    # host default 4000
# GRADIO_SERVER_NAME=127.0.0.1   # host default 0.0.0.0
# GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=false             # true publishes a public *.gradio.live link (local only)

# ==============================================================================
# Hosting mode: accounts and abuse limits (see README "Hosting mode")
# ==============================================================================
# APP_SIGNUP=open                # closed: only accounts made with `ai-agents-web users add`
# Cloudflare Turnstile CAPTCHA (free): set both keys to enable it on sign-up and login.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# APP_CAPTCHA_ON_LOGIN=true
# APP_DB_PATH=data/app.db
# APP_TRUST_PROXY=false          # true only when reachable solely via the reverse proxy
# APP_COOKIE_SECURE=true         # false only for plain-http local testing
# APP_MESSAGES_PER_ACCOUNT_PER_HOUR=20
# APP_MESSAGES_PER_ACCOUNT_PER_DAY=100
# APP_MESSAGES_PER_IP_PER_HOUR=40
# APP_MESSAGES_PER_IP_PER_DAY=200
# APP_MESSAGES_GLOBAL_PER_DAY=2000
# APP_TOOL_CALLS_PER_MINUTE=60
# APP_SIGNUPS_PER_IP_PER_DAY=3
# APP_SIGNUP_ATTEMPTS_PER_IP_PER_HOUR=10
# APP_LOGIN_FAILURES_PER_IP=20
# APP_LOGIN_FAILURES_PER_ACCOUNT=10
